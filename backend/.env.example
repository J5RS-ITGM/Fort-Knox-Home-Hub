# --- Database ---------------------------------------------------------------
# Dev default (no services needed): sqlite+aiosqlite:///./homehub.db
# Production: postgresql+asyncpg://homehub:homehub@localhost:5432/homehub
DATABASE_URL=sqlite+aiosqlite:///./homehub.db
DB_AUTO_CREATE=true

# --- Home Assistant ---------------------------------------------------------
# Mock mode simulates the full device roster; set false once HA is online.
HA_MOCK=true
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# --- API --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
