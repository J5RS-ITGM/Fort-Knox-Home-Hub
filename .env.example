# Copy to .env. NEVER commit the real .env.
POSTGRES_PASSWORD=change-me-long-random

# Home Assistant bridge (set HA_MOCK=false + URL/token to go live).
# From a VPS, HA_URL should point across your WireGuard/Tailscale tunnel —
# never a port-forwarded HA.
HA_MOCK=true
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Cookies: true in production (HTTPS). false only for plain-http dev.
COOKIE_SECURE=true
SESSION_TTL_DAYS=30

# Bind/ports (shared box defaults: loopback only, behind reverse proxy)
BIND_ADDR=127.0.0.1
BACKEND_PORT=8100
FRONTEND_PORT=3100

# Split-origin dev only (leave empty in production, same-origin):
CORS_ORIGINS=
